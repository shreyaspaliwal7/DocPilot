# free api key from google ai studio at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# primary gemini model name from google ai studio
GEMINI_CHAT_MODEL=gemini-2.5-flash
# fallback gemini model name used when primary model hits rate limit
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
# embedding model name from google ai studio
GEMINI_EMBED_MODEL=gemini-embedding-001
# embedding vector dimension configured for pgvector
EMBEDDING_DIM=768
# request throttle limit per minute based on gemini free tier
REQUESTS_PER_MINUTE=15
# max retry attempts with backoff on 429 or 503 errors
MAX_RETRIES=3
# connection string for postgres with pgvector
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/docpilot
# connection string for readonly postgres user
READONLY_DATABASE_URL=postgresql://readonly_user:readonly_pass@postgres:5432/docpilot
# character size for each text chunk
CHUNK_SIZE=800
# character overlap between consecutive chunks
CHUNK_OVERLAP=100
# number of similar chunks to retrieve
TOP_K=4
# minimum cosine similarity score to consider a chunk relevant
SCORE_THRESHOLD=0.50
# maximum document upload size in megabytes
MAX_FILE_SIZE_MB=10
# number of chunks sent per batch embedding request
BATCH_EMBED_SIZE=20
# base url for free frankfurter currency exchange api
EXCHANGE_API_URL=https://api.frankfurter.dev
# maximum rows returned by readonly sql queries
SQL_ROW_LIMIT=50
# execution timeout in seconds for sql queries
SQL_TIMEOUT_SECONDS=5
# maximum tool execution steps per user question
MAX_TOOL_STEPS=3
# cost per 1000 input tokens in dollars
COST_PER_1K_INPUT=0
# cost per 1000 output tokens in dollars
COST_PER_1K_OUTPUT=0
# base api url used by evaluation script
EVAL_API_URL=http://localhost:8000
# delay in seconds between evaluation questions
EVAL_DELAY_SECONDS=2
# backend api base url used by frontend
VITE_API_URL=http://localhost:8000
